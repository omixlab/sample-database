# Copy to .env and fill in. Values here are examples, not secrets.

# --------------------------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------------------------
# One URL selects both the server and the driver, so there is a single place to change when
# moving between databases. Unset means the packaged SQLite file at data/sample.db.
#
# Verified working on all three: schema, full-text search (FTS5 / tsvector+GIN / FULLTEXT),
# regular-expression motif search, and every read the API performs.
#
# SQLite (default; no server, nothing to install)
# SAMPLE_DATABASE_URL=sqlite+pysqlite:///data/sample.db
#
# PostgreSQL  -- needs `pip install "psycopg[binary]"`
# SAMPLE_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/sample
#
# MySQL / MariaDB -- needs `pip install pymysql`
# SAMPLE_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/sample

# Overrides only the SQLite file location; ignored when SAMPLE_DATABASE_URL is set.
# SAMPLE_DB=data/sample.db

# Hold the whole database in memory for the life of the process. Each process holds its own
# ~111 MB copy, so this is a deployment choice rather than a default.
# SAMPLE_DB_IN_MEMORY=0

# --------------------------------------------------------------------------------------------
# External services
# --------------------------------------------------------------------------------------------
# CrossRef routes requests carrying a contact address into a faster pool, and uses it to warn
# before blocking a misbehaving client.
# SAMPLE_CROSSREF_MAILTO=you@example.org

# Raises NCBI E-utilities from 3 to 10 requests per second.
# NCBI_API_KEY=

# Scopus (step 2).
# X-ELS-APIKEY=
# X-ELS-INST=

# Contact address used by PubMed and Unpaywall.
# EMAIL=you@example.org
# ALTERNATIVE_EMAILS=

# --------------------------------------------------------------------------------------------
# Environments the pipeline shells into
# --------------------------------------------------------------------------------------------
# Predictor and folding tools live in their own conda environments because their dependency sets
# cannot be resolved against this project's.
# SAMPLE_PREDICTOR_ENV=sample-predictors
# SAMPLE_FOLD_ENV=sample-fold
