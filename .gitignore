# Secrets. `.env.example` is the committed template; `.env` holds the real keys and never ships.
.env

# Everything the pipeline reads or writes. ~127 GB when fully populated, all of it either
# downloaded or reproducible by `make all`. `data/README.md` documents the layout and is the one
# file here that IS tracked.
data/*
!data/README.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/
.venv/
venv/

# Generated documentation. `docs/readme.rst` and `docs/validation_rules.rst` are regenerated from
# their Markdown sources at build time, so committing them guarantees a stale copy.
docs/_build/
docs/readme.rst
docs/validation_rules.rst

# Logs and scratch output.
logs/
out/
*.log

# Build products of the manuscript. The .tex and .md sources are tracked; the rendered PDF, the
# figures regenerated by `paper/generate_dataset_report.py` and the UMAP coordinate dump are not.
paper/figures/
paper/*.pdf
paper/*.csv
paper/*.zip
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz

# Machine-local editor and agent settings.
.claude/settings.local.json
.idea/
.vscode/
*.swp
.DS_Store

# Split out into its own repository on 2026-11-23. Present here only if someone checks it out
# alongside; the authoritative copy is the tool's own repo.
expression-wizard/
sample-expression-wizzard/
